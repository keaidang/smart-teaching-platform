{
  "$schema": "https://cdnstatic.tencentcs.com/edgeone/pages/docs/edgeone.schema.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "nodeVersion": "20",
  "mainlandRegions": ["ap-shanghai"],
  "rewrites": [
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/projects/task/P2T2", "destination": "/index.html" },
    { "source": "/industry", "destination": "/index.html" },
    { "source": "/extensions", "destination": "/index.html" },
    { "source": "/evaluation", "destination": "/index.html" },
    { "source": "/student", "destination": "/index.html" },
    { "source": "/student/preview", "destination": "/index.html" },
    { "source": "/student/homework", "destination": "/index.html" },
    { "source": "/student/exercise", "destination": "/index.html" },
    { "source": "/student/ai", "destination": "/index.html" },
    { "source": "/class", "destination": "/index.html" },
    { "source": "/class/preview", "destination": "/index.html" },
    { "source": "/class/homework", "destination": "/index.html" },
    { "source": "/class/exercise", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
